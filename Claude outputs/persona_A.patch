+                .andExpect(status().isOk())
+                .andExpect(content().contentType(MediaType.IMAGE_JPEG));
+    }
+
+    @Test
+    public void testAnInvitedUserSeesTheImageOfAPrivateEvent() throws Exception {
+        // Arrange
+        final Principal invited = () -> STRANGER_EMAIL;
+        imageBelongsTo(event(EventVisibility.PRIVATE), "image/png");
+        when(userService.findByEmail(STRANGER_EMAIL)).thenReturn(Optional.of(user(STRANGER_ID, STRANGER_EMAIL)));
