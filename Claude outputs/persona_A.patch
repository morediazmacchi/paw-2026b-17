+    private static final long IMAGE_ID = 11;
+    private static final long EVENT_ID = 4;
+    private static final long CREATOR_ID = 20;
+    private static final long STRANGER_ID = 30;
+    private static final byte[] BYTES = {1, 2, 3, 4};
