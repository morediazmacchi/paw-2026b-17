+public class SafeRedirectTest {
+
+    @Test
+    public void testAnInternalPathIsSafe() {
+        assertTrue(SafeRedirect.isSafe("/eventos/7"));
+    }
+
+    @Test
+    public void testAnInternalPathWithQueryStringIsSafe() {
+        assertTrue(SafeRedirect.isSafe("/eventos?categoria=3&orden=fecha"));
+    }
+
+    @Test
+    public void testNullIsNotSafe() {
+        assertFalse(SafeRedirect.isSafe(null));
+    }
+
+    @Test
+    public void testARelativePathWithoutLeadingSlashIsNotSafe() {
+        assertFalse(SafeRedirect.isSafe("eventos/7"));
+    }
+
+    @Test
+    public void testAProtocolRelativeUrlIsNotSafe() {
+        assertFalse(SafeRedirect.isSafe("//evil.com"));
+    }
+
+    @Test
+    public void testAnAbsoluteUrlIsNotSafe() {
+        assertFalse(SafeRedirect.isSafe("https://evil.com"));
+    }
+
+    @Test
+    public void testASlashFollowedByABackslashIsNotSafe() {
+        // Los navegadores leen "\" como "/": "/\evil.com" termina siendo "//evil.com".
+        assertFalse(SafeRedirect.isSafe("/\\evil.com"));
+    }
+
+    @Test
+    public void testASlashFollowedByATabAndASlashIsNotSafe() {
+        // Los navegadores descartan el tab de la URL: "/<tab>/evil.com" queda "//evil.com".
+        assertFalse(SafeRedirect.isSafe("/\t/evil.com"));
+    }
+
+    @Test
+    public void testALineBreakInsideThePathIsNotSafe() {
+        assertFalse(SafeRedirect.isSafe("/\n/evil.com"));
+    }
+}
