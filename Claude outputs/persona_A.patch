+
+    // ---- eventos privados ----
+
+    @Test
+    public void testAnAnonymousVisitorGets404ForTheImageOfAPrivateEvent() throws Exception {
+        // Arrange: el image.findById ni siquiera se consulta.
+        when(imageService.findOwnerEventId(IMAGE_ID)).thenReturn(Optional.of(EVENT_ID));
+        when(eventService.findById(EVENT_ID)).thenReturn(Optional.of(event(EventVisibility.PRIVATE)));
+
+        // Act + Assert
+        mockMvc.perform(get("/image/" + IMAGE_ID))
+                .andExpect(status().isNotFound());
+    }
+
+    @Test
+    public void testALoggedInStrangerGets404ForTheImageOfAPrivateEvent() throws Exception {
+        // Arrange
+        final Principal stranger = () -> STRANGER_EMAIL;
+        when(imageService.findOwnerEventId(IMAGE_ID)).thenReturn(Optional.of(EVENT_ID));
+        when(eventService.findById(EVENT_ID)).thenReturn(Optional.of(event(EventVisibility.PRIVATE)));
+        when(userService.findByEmail(STRANGER_EMAIL)).thenReturn(Optional.of(user(STRANGER_ID, STRANGER_EMAIL)));
