+package ar.edu.itba.paw.webapp.interceptor;
+
+import ar.edu.itba.paw.model.User;
+import ar.edu.itba.paw.services.UserService;
+import org.junit.Before;
+import org.junit.Test;
+import org.junit.runner.RunWith;
+import org.mockito.Mock;
+import org.mockito.junit.MockitoJUnitRunner;
+import org.springframework.mock.web.MockHttpServletRequest;
+import org.springframework.mock.web.MockHttpServletResponse;
+import org.springframework.mock.web.MockHttpSession;
+import org.springframework.web.method.HandlerMethod;
+
+import java.util.Optional;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertNull;
+import static org.junit.Assert.assertTrue;
+import static org.mockito.Mockito.when;
+
+@RunWith(MockitoJUnitRunner.class)
+public class SuspendedUserInterceptorTest {
+
+    private static final String EMAIL = "ana@test.com";
+
+    @Mock
+    private UserService userService;
+
+    private SuspendedUserInterceptor interceptor;
+    private MockHttpServletRequest request;
+    private MockHttpServletResponse response;
+    private MockHttpSession session;
+    private HandlerMethod controllerHandler;
+
+    @Before
+    public void setUp() throws Exception {
+        interceptor = new SuspendedUserInterceptor(userService);
+        session = new MockHttpSession();
+        request = new MockHttpServletRequest();
+        request.setSession(session);
+        request.setContextPath("/app");
+        response = new MockHttpServletResponse();
+        controllerHandler = new HandlerMethod(new Object(), Object.class.getMethod("toString"));
+    }
+
+    private static User user(final boolean suspended) {
+        final User user = new User(EMAIL, "Ana");
+        user.setId(5);
+        user.setSuspended(suspended);
+        return user;
+    }
+
+    @Test
+    public void testAnActiveUserContinues() throws Exception {
+        // Arrange
+        request.setUserPrincipal(() -> EMAIL);
+        when(userService.findByEmail(EMAIL)).thenReturn(Optional.of(user(false)));
+
+        // Act
+        final boolean proceed = interceptor.preHandle(request, response, controllerHandler);
+
+        // Assert
+        assertTrue(proceed);
+        assertFalse(session.isInvalid());
+    }
+
+    @Test
+    public void testASuspendedUserIsLoggedOutAndSentToTheSuspendedLoginMessage() throws Exception {
+        // Arrange
+        request.setUserPrincipal(() -> EMAIL);
+        when(userService.findByEmail(EMAIL)).thenReturn(Optional.of(user(true)));
+
+        // Act
+        final boolean proceed = interceptor.preHandle(request, response, controllerHandler);
+
+        // Assert
+        assertFalse(proceed);
+        assertTrue(session.isInvalid());
+        assertEquals("/app/login?suspended", response.getRedirectedUrl());
+    }
+
+    @Test
+    public void testAnAnonymousVisitorContinues() throws Exception {
+        // Arrange: sin Principal no hay nada que mirar.
+
+        // Act
+        final boolean proceed = interceptor.preHandle(request, response, controllerHandler);
+
+        // Assert
+        assertTrue(proceed);
+        assertNull(response.getRedirectedUrl());
+    }
+
+    @Test
+    public void testStaticResourcesAreNotCheckedEvenForASuspendedUser() throws Exception {
+        // Arrange: el handler de /css, /js no es un controller (no es un HandlerMethod).
+        request.setUserPrincipal(() -> EMAIL);
+
+        // Act
+        final boolean proceed = interceptor.preHandle(request, response, new Object());
+
+        // Assert
+        assertTrue(proceed);
+    }
+}
