+    @Override
+    @Transactional(readOnly = true)
+    public Optional<Long> findOwnerEventId(final long imageId) {
+        return imageDao.findOwnerEventId(imageId);
+    }
+
+    /** El formato real segun los primeros bytes, o null si no es JPEG/PNG/GIF/WebP. */
+    private static String detectType(final byte[] data) {
+        if (startsWith(data, 0, 0xFF, 0xD8, 0xFF)) {
+            return JPEG;
+        }
+        if (startsWith(data, 0, 0x89, 'P', 'N', 'G', 0x0D, 0x0A, 0x1A, 0x0A)) {
+            return PNG;
+        }
+        // GIF87a o GIF89a
+        if (startsWith(data, 0, 'G', 'I', 'F', '8') && (startsWith(data, 4, '7', 'a') || startsWith(data, 4, '9', 'a'))) {
+            return GIF;
+        }
+        // WebP: "RIFF" + 4 bytes de largo + "WEBP"
+        if (startsWith(data, 0, 'R', 'I', 'F', 'F') && startsWith(data, 8, 'W', 'E', 'B', 'P')) {
+            return WEBP;
+        }
+        return null;
+    }
+
+    private static boolean startsWith(final byte[] data, final int offset, final int... expected) {
+        if (data.length < offset + expected.length) {
+            return false;
+        }
+        for (int i = 0; i < expected.length; i++) {
+            if ((data[offset + i] & 0xFF) != expected[i]) {
+                return false;
+            }
+        }
+        return true;
+    }
+
     /**
      * SHA-256 en hexadecimal: 64 caracteres, que es justo el largo de la columna
      * checksum VARCHAR(64). Sirve para detectar imagenes repetidas o corrompidas.
