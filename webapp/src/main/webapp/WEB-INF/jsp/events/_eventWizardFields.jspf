<%-- Cuerpo del wizard de 5 pasos, compartido por publish.jsp y editar.jsp
     (antes eran ~450 lineas casi identicas copiadas en los dos). Include
     estatico: comparte el page/request scope de quien lo incluye, por eso
     no hace falta pasarle eventForm/fieldErrors/categories/barrios/etc.

     Variables que SI tiene que declarar quien incluye esto, antes del include:
       - formAction: action del <form>
       - submitButtonLabel: texto del boton final (distinto en publicar/editar)
       - cancelHref: href del boton "Cancelar"
       - currentImageHintLabel: opcional. Si no esta vacio, se muestra como
         hint debajo del selector de fotos (solo editar.jsp lo usa). --%>

<%-- 5 circulos conectados: event-wizard.js les agrega/saca las clases
     -active/-done segun el paso en que este parado. --%>
<div class="wizard-progress">
    <c:forEach var="n" begin="1" end="5">
        <span class="wizard-progress-step" data-step-indicator="${n}">${n}</span>
        <c:if test="${n < 5}"><span class="wizard-progress-line"></span></c:if>
    </c:forEach>
</div>

<c:if test="${not empty imageError}">
    <p class="alert"><c:out value="${imageError}"/></p>
</c:if>

<spring:message code="event.publish.titleLabel" var="titleLabel"/>
<spring:message code="event.publish.descriptionLabel" var="descriptionLabel"/>
<spring:message code="event.publish.categoryLabel" var="categoryLabel"/>
<spring:message code="event.publish.dateLabel" var="dateLabel"/>
<spring:message code="event.publish.addressLabel" var="addressLabel"/>
<spring:message code="event.publish.neighborhoodLabel" var="neighborhoodLabel"/>
<spring:message code="event.publish.priceLabel" var="priceLabel"/>
<spring:message code="event.publish.capacityLabel" var="capacityLabel"/>
<spring:message code="event.publish.imageLabel" var="imageLabel"/>
<spring:message code="event.publish.freeOption" var="freeOptionLabel"/>
<spring:message code="event.publish.noLimitOption" var="noLimitOptionLabel"/>
<spring:message code="event.publish.nextButton" var="nextButtonLabel"/>
<spring:message code="event.publish.backButton" var="backButtonLabel"/>
<spring:message code="event.publish.cancelButton" var="cancelButtonLabel"/>

<form class="wizard-form" action="${formAction}" method="post"
      enctype="multipart/form-data" novalidate="novalidate">

    <%-- ---- Paso 1: informacion basica ---- --%>
    <div class="wizard-step" data-step="1">
        <div class="wizard-step-heading">
            <h2><spring:message code="event.publish.step1Heading"/></h2>
            <p><spring:message code="event.publish.step1Subheading"/></p>
        </div>
        <paw:input name="title" maxLength="150" label="${titleLabel}" type="text"
                   value="${eventForm.title}" errorMessage="${fieldErrors.title}" />
        <paw:input name="description" maxLength="1000" label="${descriptionLabel}" type="text" required="${false}"
                   value="${eventForm.description}" errorMessage="${fieldErrors.description}" />
    </div>

    <%-- ---- Paso 2: categoria y fecha ---- --%>
    <div class="wizard-step" data-step="2" hidden>
        <div class="wizard-step-heading">
            <h2><spring:message code="event.publish.step2Heading"/></h2>
            <p><spring:message code="event.publish.step2Subheading"/></p>
        </div>
        <spring:message code="event.publish.categoryExtraInfoLabel" var="categoryExtraInfoLabel"/>
        <div class="form-group">
            <label><c:out value="${categoryLabel}"/></label>
            <div class="wizard-category-list">
                <c:forEach var="cat" items="${categories}" varStatus="catStatus">
                    <c:set var="catForm" value="${eventForm.categories[catStatus.index]}"/>
                    <div class="wizard-category-item">
                        <label class="filter-checkbox">
                            <input type="checkbox" class="wizard-category-checkbox"
                                   name="categories[${catStatus.index}].seleccionada" value="true"
                                   data-category-index="${catStatus.index}"
                                   ${catForm.seleccionada ? 'checked="checked"' : ''}/>
                            <spring:message code="category.${cat.name}" text="${cat.name}" htmlEscape="true"/>
                        </label>
                        <input type="hidden" name="categories[${catStatus.index}].categoryId" value="${cat.id}"/>
                        <div class="wizard-category-extra" ${catForm.seleccionada ? '' : 'hidden'}>
                            <c:choose>
                                <%-- "Otros" es la comodin: no tiene preguntas puntuales,
                                     sigue con el texto libre de siempre. Las demas
                                     categorias (ya existentes, fijas) tienen sus propias
                                     2 preguntas en vez de un campo generico -- pensado
                                     para dar mas info util de un vistazo en el detalle
                                     del evento (ver event-wizard.js y detail.jsp). --%>
                                <c:when test="${cat.name == 'Otros'}">
                                    <textarea name="categories[${catStatus.index}].extraInfo" maxlength="500"
                                              placeholder="${categoryExtraInfoLabel}"><c:out value="${catForm.extraInfo}"/></textarea>
                                </c:when>
                                <c:otherwise>
                                    <spring:message code="event.publish.categoryQuestion.${cat.name}.1" var="catQuestion1"/>
                                    <spring:message code="event.publish.categoryQuestion.${cat.name}.2" var="catQuestion2"/>
                                    <div class="wizard-category-questions" data-category-questions>
                                        <textarea class="wizard-category-question" rows="2" maxlength="200"
                                                  data-question="${catQuestion1}" placeholder="${catQuestion1}"></textarea>
                                        <textarea class="wizard-category-question" rows="2" maxlength="200"
                                                  data-question="${catQuestion2}" placeholder="${catQuestion2}"></textarea>
                                    </div>
                                    <%-- Lo que realmente viaja al server: event-wizard.js combina las
                                         dos respuestas de arriba en "Pregunta: Respuesta" por linea,
                                         igual formato que ya entendia extraInfo (texto libre). --%>
                                    <textarea name="categories[${catStatus.index}].extraInfo" maxlength="500"
                                              class="wizard-category-extra-hidden" hidden
                                              data-category-extra-hidden><c:out value="${catForm.extraInfo}"/></textarea>
                                </c:otherwise>
                            </c:choose>
                        </div>
                    </div>
                </c:forEach>
            </div>
            <c:if test="${not empty categoriasError}">
                <span class="error-message"><c:out value="${categoriasError}"/></span>
            </c:if>
        </div>
        <div class="form-group">
            <label for="eventDateTrigger"><c:out value="${dateLabel}"/></label>
            <div class="wizard-datetime-row">
                <%-- El <input type="date"> nativo no se puede restylear (el popup
                     lo dibuja el SO/navegador): en su lugar, un boton que abre el
                     almanaque propio de mas abajo (mismo modal generico de siempre). --%>
                <button type="button" id="eventDateTrigger" class="calendar-trigger"
                        data-open-modal="eventDateCalendarModal">
                    <paw:icon name="calendar"/>
                    <span class="calendar-trigger-text" data-calendar-trigger-text></span>
                </button>
                <input type="hidden" id="eventDateDate"/>
                <%-- Nada de <input type="time">: ese widget depende de la
                     configuracion regional del navegador y en muchas
                     termina mostrando AM/PM igual. Dos campos numéricos
                     (0-23 / 0-59) no tienen ese problema: son solo numeros. --%>
                <div class="wizard-time-row">
                    <input type="number" id="eventDateHours" min="0" max="23"
                           placeholder="HH" inputmode="numeric" required="required"/>
                    <span class="wizard-time-separator">:</span>
                    <input type="number" id="eventDateMinutes" min="0" max="59"
                           placeholder="MM" inputmode="numeric" required="required"/>
                </div>
            </div>
            <p class="wizard-field-hint"><spring:message code="event.publish.timeFormatHint"/></p>
            <c:if test="${not empty fieldErrors.eventDate}">
                <span class="error-message"><c:out value="${fieldErrors.eventDate}"/></span>
            </c:if>
            <%-- Lo que realmente viaja al servidor: event-wizard.js lo arma
                 combinando los campos de arriba (splitea eventForm.eventDate
                 en fecha/hora/minutos al cargar la pagina si ya traia uno). --%>
            <input type="hidden" id="eventDate" name="eventDate" value="<c:out value='${eventForm.eventDate}'/>"/>
        </div>

        <%-- Almanaque: la grilla de dias la arma event-wizard.js. Los dias
             fuera de hoy..+2anios vienen deshabilitados desde el propio JS,
             asi que no hace falta validar despues "fecha fuera de rango":
             no se puede clickear una fecha invalida. --%>
        <div class="modal-overlay calendar-modal" id="eventDateCalendarModal" hidden>
            <div class="modal-box calendar-box">
                <div class="modal-header">
                    <h2><c:out value="${dateLabel}"/></h2>
                    <button type="button" class="modal-close" data-close-modal
                            aria-label="<spring:message code='event.detail.closeButton'/>">
                        <paw:icon name="close"/>
                    </button>
                </div>
                <div class="calendar-header">
                    <button type="button" class="calendar-nav" data-calendar-prev
                            aria-label="<spring:message code='event.publish.prevMonth'/>">
                        <paw:icon name="chevron-left"/>
                    </button>
                    <span class="calendar-month-label" data-calendar-month-label></span>
                    <button type="button" class="calendar-nav" data-calendar-next
                            aria-label="<spring:message code='event.publish.nextMonth'/>">
                        <paw:icon name="chevron-right"/>
                    </button>
                </div>
                <div class="calendar-weekdays">
                    <span>L</span><span>M</span><span>M</span><span>J</span><span>V</span><span>S</span><span>D</span>
                </div>
                <div class="calendar-days" data-calendar-days></div>
            </div>
        </div>
    </div>

    <%-- ---- Paso 3: ubicacion ---- --%>
    <div class="wizard-step" data-step="3" hidden>
        <div class="wizard-step-heading">
            <h2><spring:message code="event.publish.step3Heading"/></h2>
            <p><spring:message code="event.publish.step3Subheading"/></p>
        </div>
        <paw:input name="address" maxLength="200" label="${addressLabel}" type="text"
                   value="${eventForm.address}" errorMessage="${fieldErrors.address}" />
        <spring:message code="event.publish.addressDetailsLabel" var="addressDetailsLabel"/>
        <paw:input name="addressDetails" maxLength="300" label="${addressDetailsLabel}" type="text" required="${false}"
                   value="${eventForm.addressDetails}" errorMessage="${fieldErrors.addressDetails}" />

        <%-- Elegis EXPLICITAMENTE entre geocodificar la direccion contra
             Nominatim (mapa de solo lectura, barrio deducido) o cargarla
             vos a mano (select de barrio + click en el mapa). Nunca pasa
             solo de uno a otro (ver event-location-map.js): si Nominatim
             no puede identificar el barrio de un lugar (pasa con parques/
             zonas grandes), solo se avisa, no se cambia de modo. Si el
             eventForm ya traia un pin cargado, arranca en el modo con el
             que se habia puesto la ultima vez. --%>
        <c:set var="modoManual" value="${eventForm.locationManual == 'true'}"/>
        <div class="form-group">
            <label><spring:message code="event.publish.addressModeLabel"/></label>
            <div class="address-mode-toggle">
                <label class="filter-checkbox">
                    <input type="radio" id="modo-direccion-geo" name="modo-direccion" value="geo"
                           ${modoManual ? '' : 'checked="checked"'}/>
                    <spring:message code="event.publish.addressModeGeo"/>
                </label>
                <label class="filter-checkbox">
                    <input type="radio" id="modo-direccion-manual" name="modo-direccion" value="manual"
                           ${modoManual ? 'checked="checked"' : ''}/>
                    <spring:message code="event.publish.addressModeManual"/>
                </label>
            </div>
        </div>

        <%-- Modo "con geolocalizacion". Los data-* son los textos de estado
             en el idioma actual, porque event-location-map.js es JS estatico
             y no puede usar spring:message (mismo criterio que
             favorite-toggle.js). --%>
        <spring:message code="event.publish.geocodeButton" var="geocodeButtonLabel"/>
        <spring:message code="event.publish.geocodeSearching" var="geocodeSearchingLabel"/>
        <spring:message code="event.publish.geocodeNotFound" var="geocodeNotFoundLabel"/>
        <spring:message code="event.publish.geocodeError" var="geocodeErrorLabel"/>
        <spring:message code="event.publish.geocodeNoBarrio" var="geocodeNoBarrioLabel"/>
        <spring:message code="event.publish.suggestionsHeading" var="suggestionsHeadingLabel"/>
        <div id="geo-search-panel" ${modoManual ? 'hidden' : ''}>
            <button type="button" id="geocode-address" class="btn btn-medium"
                    data-searching-label="${geocodeSearchingLabel}"
                    data-not-found-label="${geocodeNotFoundLabel}"
                    data-error-label="${geocodeErrorLabel}"
                    data-no-barrio-label="${geocodeNoBarrioLabel}"
                    data-suggestions-heading="${suggestionsHeadingLabel}">
                <c:out value="${geocodeButtonLabel}"/>
            </button>
            <p id="geocode-status" class="wizard-field-hint" role="status" hidden></p>
            <ul id="geocode-suggestions" class="geocode-suggestions" hidden></ul>
        </div>

        <%-- Barrio: en modo geo es solo texto (deducido, no se toca); en
             modo manual es el <select> de siempre. Los dos comparten esta
             misma columna del form (name="neighborhood"), asi que da igual cual
             de los dos esta oculto -- el que este visible es el que la
             persona uso. --%>
        <c:set var="currentBarrioDisplay" value=""/>
        <c:forEach var="b" items="${barrios}">
            <c:if test="${b.name() == eventForm.neighborhood}"><c:set var="currentBarrioDisplay" value="${b.displayName}"/></c:if>
        </c:forEach>
        <div class="form-group">
            <label><c:out value="${neighborhoodLabel}"/></label>
            <p id="neighborhood-display" class="wizard-field-hint" ${modoManual ? 'hidden' : ''}><c:out value="${currentBarrioDisplay}"/></p>
            <select id="neighborhood" name="neighborhood" required="required" ${modoManual ? '' : 'hidden'}>
                <option value="" disabled="disabled" ${empty eventForm.neighborhood ? 'selected="selected"' : ''}></option>
                <c:forEach var="b" items="${barrios}">
                    <option value="${b}" ${b.name() == eventForm.neighborhood ? 'selected' : ''}>
                        <c:out value="${b.displayName}"/>
                    </option>
                </c:forEach>
            </select>
            <c:if test="${not empty fieldErrors.neighborhood}">
                <span class="error-message"><c:out value="${fieldErrors.neighborhood}"/></span>
            </c:if>
        </div>
        <%-- De los 48 barrios (nombre de enum -> nombre para mostrar), para que
             event-location-map.js pueda deducir el barrio del "suburb" que
             devuelve Nominatim sin tener una segunda lista hardcodeada en JS:
             esta sale directo de Barrio.values() (${barrios}, ya la trae el
             controller para el <select> de arriba), asi que si el enum cambia
             esto cambia solo. --%>
        <script>
            window.PAW_BARRIOS = {
                <c:forEach var="b" items="${barrios}" varStatus="st">"${b.name()}": "<c:out value='${b.displayName}'/>"<c:if test="${!st.last}">,</c:if></c:forEach>
            };
        </script>
        <div class="form-group">
            <label><spring:message code="event.publish.mapLabel"/></label>
            <p id="map-hint-geo" class="wizard-field-hint" ${modoManual ? 'hidden' : ''}>
                <spring:message code="event.publish.mapHint"/>
            </p>
            <p id="map-hint-manual" class="wizard-field-hint" ${modoManual ? '' : 'hidden'}>
                <spring:message code="event.publish.mapHintManual"/>
            </p>
            <%-- Si el eventForm ya traia un pin cargado, event-location-map.js
                 arranca centrado ahi (ver los value de latitude/longitude de
                 abajo); si no, arranca en Buenos Aires. --%>
            <div id="location-map" class="wizard-map"></div>
            <input type="hidden" id="latitude" name="latitude" value="<c:out value='${eventForm.latitude}'/>"/>
            <input type="hidden" id="longitude" name="longitude" value="<c:out value='${eventForm.longitude}'/>"/>
            <input type="hidden" id="location-manual" name="locationManual" value="<c:out value='${eventForm.locationManual}'/>"/>
        </div>
    </div>

    <%-- ---- Paso 4: imagen y precio ---- --%>
    <div class="wizard-step" data-step="4" hidden>
        <div class="wizard-step-heading">
            <h2><spring:message code="event.publish.step4Heading"/></h2>
            <p><spring:message code="event.publish.step4Subheading"/></p>
        </div>
        <div class="form-group">
            <label><c:out value="${imageLabel}"/></label>
            <label class="wizard-dropzone" for="images">
                <paw:icon name="image"/>
                <span class="wizard-dropzone-label"><spring:message code="event.publish.imageDropHint"/></span>
                <span class="wizard-dropzone-filename" hidden></span>
            </label>
            <spring:message code="event.publish.tooManyImagesError" var="tooManyImagesMsg"/>
            <spring:message code="event.publish.imageTooLarge" var="tooLargeImageMsg"/>
            <spring:message code="event.publish.coverLabel" var="coverLabelMsg"/>
            <spring:message code="event.publish.removeImage" var="removeImageMsg"/>
            <input type="file" id="images" name="images" accept="image/*" multiple="multiple"
                   class="wizard-dropzone-input"
                   data-max-message="<c:out value='${tooManyImagesMsg}'/>"
                   data-too-large-message="<c:out value='${tooLargeImageMsg}'/>"
                   data-cover-label="<c:out value='${coverLabelMsg}'/>"
                   data-remove-label="<c:out value='${removeImageMsg}'/>"/>
            <%-- Solo editar.jsp declara currentImageHintLabel: ahi las fotos son
                 opcionales porque ya puede haber alguna cargada (si no se toca
                 este campo, el controller mantiene la galeria que ya tenia). --%>
            <c:if test="${not empty currentImageHintLabel}">
                <p class="wizard-field-hint"><c:out value="${currentImageHintLabel}"/></p>
            </c:if>
        </div>
        <paw:input name="price" label="${priceLabel}" digitsOnly="${true}" maxLength="8" placeholder="10000"
                   value="${eventForm.price}" errorMessage="${fieldErrors.price}"
                   toggleText="${freeOptionLabel}" />
        <paw:input name="maxCapacity" label="${capacityLabel}" digitsOnly="${true}" maxLength="9" placeholder="100"
                   value="${eventForm.maxCapacity}" errorMessage="${fieldErrors.maxCapacity}"
                   toggleText="${noLimitOptionLabel}" />
        <div class="form-group">
            <label class="filter-checkbox">
                <input type="checkbox" id="requiresApproval" name="requiresApproval" value="true"
                       ${eventForm.requiresApproval ? 'checked="checked"' : ''}/>
                <spring:message code="event.publish.requiresApprovalLabel"/>
            </label>
            <p class="wizard-field-hint"><spring:message code="event.publish.requiresApprovalHint"/></p>
        </div>
        <div class="form-group">
            <label class="filter-checkbox">
                <input type="checkbox" id="privateEvent" name="privateEvent" value="true"
                       ${eventForm.privateEvent ? 'checked="checked"' : ''}/>
                <spring:message code="event.publish.privateLabel"/>
            </label>
            <p class="wizard-field-hint"><spring:message code="event.publish.privateHint"/></p>
        </div>
        <div class="form-group">
            <label class="filter-checkbox">
                <input type="checkbox" id="parking" name="parking" value="true"
                       ${eventForm.parking ? 'checked="checked"' : ''}/>
                <spring:message code="event.publish.parkingLabel"/>
            </label>
        </div>
    </div>

    <%-- ---- Paso 5: revisar y confirmar ---- --%>
    <div class="wizard-step" data-step="5" hidden>
        <div class="wizard-step-heading">
            <h2><spring:message code="event.publish.step5Heading"/></h2>
            <p><spring:message code="event.publish.step5Subheading"/></p>
        </div>
        <%-- event-wizard.js completa esto con lo que se cargo en los pasos
             anteriores justo antes de mostrar este paso. --%>
        <div class="wizard-review">
            <div class="wizard-review-row">
                <span class="wizard-review-label"><c:out value="${titleLabel}"/></span>
                <span class="wizard-review-value" data-review="title"></span>
            </div>
            <div class="wizard-review-row">
                <span class="wizard-review-label"><c:out value="${categoryLabel}"/></span>
                <span class="wizard-review-value" data-review="categoria"></span>
            </div>
            <div class="wizard-review-row">
                <span class="wizard-review-label"><c:out value="${dateLabel}"/></span>
                <span class="wizard-review-value" data-review="fecha"></span>
            </div>
            <div class="wizard-review-row">
                <span class="wizard-review-label"><c:out value="${addressLabel}"/></span>
                <span class="wizard-review-value" data-review="address"></span>
            </div>
            <div class="wizard-review-row">
                <span class="wizard-review-label"><c:out value="${priceLabel}"/></span>
                <span class="wizard-review-value" data-review="price"></span>
            </div>
            <div class="wizard-review-row">
                <span class="wizard-review-label"><c:out value="${capacityLabel}"/></span>
                <span class="wizard-review-value" data-review="cupo"></span>
            </div>
            <div class="wizard-review-row">
                <spring:message code="event.publish.requiresApprovalLabel" var="requiresApprovalLabel"/>
                <spring:message code="common.yes" var="yesLabel"/>
                <spring:message code="common.no" var="noLabel"/>
                <span class="wizard-review-label"><c:out value="${requiresApprovalLabel}"/></span>
                <span class="wizard-review-value" data-review="requiresApproval"
                      data-yes-label="${yesLabel}" data-no-label="${noLabel}"></span>
            </div>
            <div class="wizard-review-row">
                <spring:message code="event.publish.privateLabel" var="privateLabel"/>
                <span class="wizard-review-label"><c:out value="${privateLabel}"/></span>
                <span class="wizard-review-value" data-review="privateEvent"
                      data-yes-label="${yesLabel}" data-no-label="${noLabel}"></span>
            </div>
            <div class="wizard-review-row">
                <spring:message code="event.publish.parkingLabel" var="parkingLabel"/>
                <span class="wizard-review-label"><c:out value="${parkingLabel}"/></span>
                <span class="wizard-review-value" data-review="parking"
                      data-yes-label="${yesLabel}" data-no-label="${noLabel}"></span>
            </div>
            <div class="wizard-review-row" data-review-image-row hidden>
                <span class="wizard-review-label"><c:out value="${imageLabel}"/></span>
                <span class="wizard-review-image-wrap">
                    <img class="wizard-review-image" data-review-image alt=""/>
                    <span class="wizard-review-image-count" data-review-image-count></span>
                </span>
            </div>
        </div>
    </div>

    <%-- event-wizard.js la muestra cuando "Siguiente" encuentra algo
         invalido en el paso actual: un mensaje propio, siempre visible,
         en vez de depender de la burbuja nativa del navegador (que en
         algunos casos - el ejemplo real: una fecha pasada - es facil
         que pase desapercibida). --%>
    <p class="alert wizard-step-error" hidden></p>

    <div class="wizard-actions">
        <button type="button" class="btn btn-medium wizard-back" data-wizard-back hidden>
            <c:out value="${backButtonLabel}"/>
        </button>
        <a class="btn btn-medium wizard-cancel" href="${cancelHref}">
            <c:out value="${cancelButtonLabel}"/>
        </a>
        <button type="button" class="btn btn-medium btn-accent wizard-next" data-wizard-next>
            <c:out value="${nextButtonLabel}"/>
        </button>
        <span class="wizard-submit" hidden>
            <paw:button text="${submitButtonLabel}" cssClass="btn-accent" />
        </span>
    </div>
</form>
