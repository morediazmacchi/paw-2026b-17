<?xml version="1.0" encoding="UTF-8"?>
<web-app
    version="4.0"
    xmlns="http://xmlns.jcp.org/xml/ns/javaee"
    xmlns:javaee="http://xmlns.jcp.org/xml/ns/javaee"
    xmlns:xml="http://www.w3.org/XML/1998/namespace"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd">
  <display-name>PAW 2026B Webapp</display-name>
  <context-param>
    <param-name>contextClass</param-name>
    <param-value>org.springframework.web.context.support.AnnotationConfigWebApplicationContext</param-value>
  </context-param>
  <context-param>
    <param-name>contextConfigLocation</param-name>
    <param-value>
      ar.edu.itba.paw.webapp.config.RootConfig
    </param-value>
  </context-param>

  <listener>
    <listener-class>org.springframework.web.context.ContextLoaderListener</listener-class>
  </listener>

  <!-- Avisa al SessionRegistry de Spring Security cuando una sesion termina (logout, timeout) o cambia
       de id (al loguearse). Sin esto el registro nunca olvida las sesiones muertas (ver
       SessionExpiringListener y WebAuthConfig.sessionRegistry). -->
  <listener>
    <listener-class>org.springframework.security.web.session.HttpSessionEventPublisher</listener-class>
  </listener>

  <!-- ORDEN DE LOS FILTROS: los filtros corren en el orden de sus <filter-mapping> (no de sus <filter>),
       siempre antes de cualquier controller. 1) encoding UTF-8, 2) Spring Security, 3) OpenEntityManagerInView.
       El encoding va PRIMERO porque el login de Spring Security lee los parametros del form (email,
       password): si los lee antes de que se fije UTF-8, acentos y "n" con tilde se decodifican mal. -->
  <filter>
    <filter-name>characterEncodingFilter</filter-name>
    <filter-class>org.springframework.web.filter.CharacterEncodingFilter</filter-class>
    <init-param>
      <param-name>encoding</param-name>
      <param-value>UTF-8</param-value>
    </init-param>
    <init-param>
      <param-name>forceEncoding</param-name>
      <param-value>true</param-value>
    </init-param>
  </filter>

  <!-- Delega en el bean "springSecurityFilterChain" que arma WebAuthConfig (@EnableWebSecurity) en el
       contexto raiz. -->
  <filter>
    <filter-name>springSecurityFilterChain</filter-name>
    <filter-class>org.springframework.web.filter.DelegatingFilterProxy</filter-class>
    <async-supported>true</async-supported>
  </filter>

  <!-- Mantiene abierta la sesion de Hibernate (el EntityManager) durante todo el request,
       incluido el renderizado del JSP. Sin esto, tocar una relacion lazy desde el JSP tira
       LazyInitializationException porque la transaccion del service ya cerro. Tiene que ir
       DESPUES del filtro de Spring Security (ver el orden de los mappings de abajo). -->
  <filter>
    <filter-name>openEntityManagerInViewFilter</filter-name>
    <filter-class>org.springframework.orm.jpa.support.OpenEntityManagerInViewFilter</filter-class>
  </filter>

  <filter-mapping>
    <filter-name>characterEncodingFilter</filter-name>
    <url-pattern>/*</url-pattern>
  </filter-mapping>
  <!-- REQUEST + ERROR + ASYNC: ERROR para que las paginas de error (ver <error-page> abajo) vean la sesion
       de quien las pide, ASYNC por si algun dia hay requests asincronicos. -->
  <filter-mapping>
    <filter-name>springSecurityFilterChain</filter-name>
    <url-pattern>/*</url-pattern>
    <dispatcher>REQUEST</dispatcher>
    <dispatcher>ERROR</dispatcher>
    <dispatcher>ASYNC</dispatcher>
  </filter-mapping>
  <filter-mapping>
    <filter-name>openEntityManagerInViewFilter</filter-name>
    <url-pattern>/*</url-pattern>
  </filter-mapping>

  <servlet>
    <servlet-name>dispatcher</servlet-name>
    <servlet-class>org.springframework.web.servlet.DispatcherServlet</servlet-class>
    <init-param>
      <param-name>contextClass</param-name>
      <param-value>org.springframework.web.context.support.AnnotationConfigWebApplicationContext</param-value>
    </init-param>
    <init-param>
      <param-name>contextConfigLocation</param-name>
      <param-value>ar.edu.itba.paw.webapp.config.WebConfig</param-value>
    </init-param>
    <load-on-startup>1</load-on-startup>
    <multipart-config>
      <!-- Muro duro del servidor. Las reglas que se le muestran al usuario
           estan en ImageService: 5 MB por foto de evento (hasta 5 fotos, ver
           Event.MAX_IMAGES) y 100 MB la portada del perfil. Aca: 100 MB por
           archivo (lo que admite la portada) y 110 MB por pedido (la portada
           mas los campos del formulario; un evento legitimo son 25 MB). Asi
           cualquier foto de evento "de mas" llega hasta la validacion prolija
           de ImageServiceImpl (que conserva lo que el usuario ya escribio en
           el formulario) en vez de romper el parseo del multipart entero, que
           pierde todos los campos y en Pampero se ve como un 502 crudo de
           Apache. ErrorAdvice atrapa el caso extremo (mas de estos limites)
           como red de contencion. -->
      <max-file-size>104857600</max-file-size>
      <max-request-size>115343360</max-request-size>
      <file-size-threshold>0</file-size-threshold>
    </multipart-config>
  </servlet>

  <servlet-mapping>
    <servlet-name>dispatcher</servlet-name>
    <url-pattern>/</url-pattern>
  </servlet-mapping>

  <session-config>
    <session-timeout>30</session-timeout>
    <!-- HttpOnly: JavaScript no puede leer la cookie de sesion (si hubiera un XSS no la roba).
         tracking-mode COOKIE: nunca se acepta el id de sesion por la URL (;jsessionid=).
         NO se pone <secure> aca: la app local corre sobre HTTP y la cookie dejaria de enviarse. En el deploy
         (Tomcat) el flag Secure y SameSite=Lax se configuran en el CookieProcessor del contexto
         (<CookieProcessor sameSiteCookies="lax"/>) y, si hay HTTPS, con <secure>true</secure> aca. -->
    <cookie-config>
      <http-only>true</http-only>
    </cookie-config>
    <tracking-mode>COOKIE</tracking-mode>
  </session-config>

  <!-- Paginas de error propias en vez de las de Tomcat. Esto cubre lo que
       ErrorAdvice no puede: una URL que no coincide con ningun controller nunca
       llega a uno, asi que @ControllerAdvice no la ve. Apuntan a rutas de
       ErrorPageController (no al JSP directo) para que la vista se renderice
       con el contexto de Spring: los <spring:message> lo necesitan.
       El 400 va a la pagina de "no encontrado" porque su texto ya cubre el caso
       de un link mal escrito. -->
  <error-page>
    <error-code>400</error-code>
    <location>/error/404</location>
  </error-page>
  <error-page>
    <error-code>404</error-code>
    <location>/error/404</location>
  </error-page>
  <error-page>
    <error-code>500</error-code>
    <location>/error/500</location>
  </error-page>
</web-app>
